# Copy to .env.local for local overrides. Not needed for local dev against
# the Vite proxy (vite.config.ts already forwards /api to localhost:4000).
#
# In Vercel, set this as a build-time environment variable pointing at your
# deployed Railway API, including the /api suffix, e.g.:
#   VITE_API_URL=https://optiflow-api.up.railway.app/api
VITE_API_URL=
